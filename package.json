{
  "name": "aurevia-saas",
  "version": "1.0.0",
  "description": "Site de la formation AUREVIA SAAS",
  "scripts": {
    "donnees:extraire": "node scripts/extraire-donnees.mjs",
    "donnees:construire": "node scripts/construire-donnees.mjs",
    "donnees:verifier": "node scripts/verifier-donnees.mjs",
    "dev": "astro dev",
    "build": "node scripts/verifier-donnees.mjs && astro build",
    "serveur": "node scripts/serveur-local.mjs",
    "test:unitaires": "node --test tests/unitaires/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run donnees:verifier && npm run test:unitaires && npm run build && npm run test:e2e",
    "apercu": "npm run build && node scripts/preparer-apercu.mjs",
    "sauvegarde": "bash scripts/creer-sauvegarde.sh"
  },
  "author": "Arthur Leloup",
  "license": "UNLICENSED",
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "astro": "^7.4.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@netlify/blobs": "^11.1.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
