# Noms des variables de configuration (aucune valeur ici).
# En local : copiez ce fichier en « .env » (jamais publié). Sur Netlify : saisissez-les dans
# Site configuration > Environment variables. Une variable vide = fonction « non connectée »
# ou valeur par défaut indiquée en commentaire.

# Adresse publique du site, ex. https://www.votre-domaine.fr (sitemap, liens canoniques, indexation)
SITE_URL=
# Texte aléatoire secret (32 caractères ou plus) pour rendre les adresses IP non réversibles
SEL_EMPREINTE=

# E-mails via Brevo (confirmations d'inscription, accusés de rétractation)
BREVO_API_KEY=
# Adresse d'expédition validée chez Brevo
EMAIL_EXPEDITEUR=
# Nom affiché de l'expéditeur (défaut : AUREVIA SAAS)
EMAIL_NOM_EXPEDITEUR=
# Adresse de réponse (facultatif)
EMAIL_REPONSE=
# Reçoit une copie de chaque inscription et rétractation (facultatif)
EMAIL_ORGANISATEUR=

# Assistant IA (Anthropic) : la clé reste sur le serveur.
# L'IA payante ne s'active QUE si ASSISTANT_IA vaut « active » ET qu'une clé est présente.
# Sinon l'assistant répond gratuitement en mode secours, avec les informations du site.
ASSISTANT_IA=
ANTHROPIC_API_KEY=
# Modèle (défaut : claude-opus-5-5 ; claude-haiku-5-5 coûte environ 40 fois moins cher)
ASSISTANT_MODELE=
# Longueur maximale d'une réponse en jetons (défaut : 1500)
ASSISTANT_MAX_TOKENS=
# Niveau de réflexion : low, medium ou high (défaut : low)
ASSISTANT_EFFORT=
# Délai maximal d'un appel en millisecondes (défaut : 8000, plafonné à 9000 pour Netlify)
ASSISTANT_DELAI_MS=
# Questions par visiteur et par jour (défaut : 20)
ASSISTANT_LIMITE_IP_JOUR=
# Questions au total par jour (défaut : 200)
ASSISTANT_LIMITE_JOUR=

# Envois de formulaire par visiteur et par heure (défaut : 10)
LIMITE_FORMULAIRES_HEURE=
# Autres adresses autorisées à appeler /api, séparées par des virgules (ex. https://aurevia.netlify.app)
ORIGINES_AUTORISEES=

# Statistiques sans cookies (désactivées tant que vides)
PUBLIC_STATS_SCRIPT=
PUBLIC_STATS_DOMAINE=
