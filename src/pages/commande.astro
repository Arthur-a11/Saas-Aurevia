---
// Commande d'une formule : compte obligatoire, accords horodatés, puis paiement sur la page sécurisée de Stripe.
// L'accès n'est ouvert qu'après la confirmation du paiement reçue et vérifiée par le serveur.
// Sans paiement configuré côté serveur, la page reste fermée et propose l'inscription sans paiement.
import Base from "../layouts/Base.astro";
import Case from "../components/Case.astro";
import { site, mentionTaxes, contenuFormule, LIBELLE_STATUT } from "../lib/site.js";
import { TEXTES_CONSENTEMENT as T } from "../../serveur/validation.js";
import AC from "../components/ACompleter.astro";
import conditions from "../data/conditions.json";
const e = site.entreprise;
const o = conditions.ouvertureSansRenonciation;
const duree = conditions.dureeAcces.valeur ? conditions.dureeAcces.options[conditions.dureeAcces.valeur] : null;
---
<Base titre="Commande" noindex description="Commander une formule AUREVIA SAAS.">
  <section class="entete-page">
    <div class="wrap">
      <p class="retour"><a href="/tarifs/">← Retour aux tarifs</a></p>
      <h1 class="titre-degrade">Commande</h1>
      <div class="encadre" id="commandes-fermees">
        <p><strong>Les commandes en ligne ne sont pas encore ouvertes.</strong></p>
        <p>Vous pouvez vous inscrire dès maintenant, sans paiement : je vous recontacte par e-mail pour la suite.</p>
        <p><a class="btn" href="/inscription/" id="lien-inscription">M’inscrire sans payer</a></p>
      </div>
    </div>
  </section>

  <section class="section-serree" id="zone-commande" hidden>
    <div class="wrap">
      <ol class="etapes-commande" id="etapes-commande" aria-label="Étapes de la commande">
        <li data-etape="formule">Formule</li>
        <li data-etape="compte">Compte</li>
        <li data-etape="conditions">Conditions</li>
        <li data-etape="paiement">Paiement</li>
        <li data-etape="acces">Accès à la formation</li>
      </ol>
      <p class="encadre attention" id="bandeau-test" hidden><strong>Mode test :</strong> aucun paiement réel n’est possible. Sur la page de paiement, utilisez une carte de test Stripe (par exemple 4242 4242 4242 4242).</p>
      <div id="message-commande" class="message-formulaire" role="status" hidden></div>

      <div id="bloc-connexion" class="carte" hidden>
        <h2 class="titre-carte">Étape 1 : votre compte</h2>
        <p>Pour retrouver votre formation après le paiement, connectez-vous ou créez votre compte.</p>
        <p class="cta"><a class="btn" id="lien-compte" href="/compte/">Me connecter ou créer mon compte</a></p>
      </div>

      <form class="commande-grille" id="form-commande" novalidate hidden>
        <fieldset class="carte choix-formules">
          <legend class="titre-carte">Votre formule</legend>
          {site.formules.map((f) => (
            <div class="choix-formule">
              <input type="radio" name="formule" id={`formule-${f.id}`} value={f.id} checked={f.id === "complet"} aria-describedby={`contenu-${f.id}`} />
              <label class="choix-entete" for={`formule-${f.id}`}><strong>{f.nom}</strong><span class="mono">{f.prixAffiche}</span></label>
              <ul class="liste-contenu" id={`contenu-${f.id}`}>
                {contenuFormule(f).map((x) => <li>{x.texte}{LIBELLE_STATUT[x.statut] && <span class="statut">{LIBELLE_STATUT[x.statut]}</span>}</li>)}
              </ul>
              <p class="ferme-raison" data-raison={f.id} hidden></p>
            </div>
          ))}
          <p class="note">Paiement unique, sans abonnement ni prélèvement. Prix : {mentionTaxes()}.</p>
        </fieldset>

        <div class="carte formulaire commande-accords">
          <div class="pleine avant-paiement">
            <h2 class="titre-carte">Avant de payer</h2>
            <ul>
              <li><strong>Paiement unique</strong>, sans abonnement ni prélèvement.</li>
              <li><strong>Ouverture de l’accès :</strong> si vous cochez la case d’accès immédiat, dès la confirmation du paiement. Sinon, {o.valeur === "immediate" ? "dès la confirmation du paiement également, et vous gardez votre droit de rétractation de 14 jours" : `${o.delaiJours} jours après le paiement, à la fin du délai de rétractation`}.</li>
              <li><strong>Durée d’accès :</strong> {duree ?? <AC label="durée d’accès à décider" />}.</li>
              <li><strong>Vendeur :</strong> {e.denomination ?? <AC label="nom de l’entreprise" />} ({e.formeJuridique ?? <AC label="forme juridique" />}), SIREN {e.siren ?? <AC label="SIREN" />}. Médiateur : {site.mediateur.nom ?? <AC label="médiateur de la consommation" />}.</li>
            </ul>
            <p class="note">Une confirmation reprenant vos choix et la version des conditions ({conditions.versionConditions}) vous est adressée par e-mail lorsque l’envoi d’e-mails est en service.</p>
          </div>
          <h2 class="titre-carte pleine">Vos accords</h2>
          <Case nom="cgv" requis>J’ai lu et j’accepte les <a href="/cgv/">conditions générales de vente</a>.</Case>
          <Case nom="accesImmediat">{T.accesImmediat} (Facultatif : sans cette case, vous gardez votre droit de rétractation et l’accès s’ouvre à la fin du délai de 14 jours.)</Case>
          <div id="bloc-service" class="pleine" hidden><Case nom="executionService">{T.executionService} (Facultatif.)</Case></div>
          <div class="pleine">
            <button class="btn bouton-large" type="submit" id="bouton-payer">Payer sur la page sécurisée</button>
            <p class="note">Vous serez redirigé(e) vers Stripe, le prestataire de paiement. Votre formation s’ouvre dès que Stripe nous confirme le paiement.</p>
          </div>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { afficherErreurs, message } from "../lib/formulaire";
  import { api, el } from "../lib/espace-client";
  import { validerAchat } from "../../serveur/validation.js";
  import site from "../data/site.json";

  const params = new URLSearchParams(location.search);
  const choix = params.get("formule");
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const form = $("form-commande") as HTMLFormElement;
  const zoneMsg = $("message-commande");
  const prix = (id: string) => site.formules.find((f) => f.id === id)?.prixAffiche ?? "";
  const formuleChoisie = () => (form.querySelector("input[name=formule]:checked") as HTMLInputElement | null)?.value ?? "";
  if (choix && site.formules.some((f) => f.id === choix)) {
    (form.querySelector(`input[name=formule][value="${choix}"]`) as HTMLInputElement).checked = true;
    ($("lien-inscription") as HTMLAnchorElement).href = `/inscription/?formule=${choix}`;
  }
  const majFormule = () => {
    $("bloc-service").hidden = formuleChoisie() !== "accompagne";
    $("bouton-payer").textContent = `Payer ${prix(formuleChoisie())} sur la page sécurisée`;
  };
  form.addEventListener("change", majFormule);
  majFormule();

  const RAISONS: Record<string, string> = {
    ventes_fermees: "Ventes pas encore ouvertes.",
    contenus_en_preparation: "Des contenus de cette formule sont encore en préparation.",
    confirmation_email_impossible: "L’e-mail de confirmation n’est pas encore en service.",
  };

  /** Étapes : faites, actuelle (aria-current="step"), à venir. */
  function etape(actuelle: string) {
    const ordre = ["formule", "compte", "conditions", "paiement", "acces"];
    const i = ordre.indexOf(actuelle);
    for (const li of Array.from(document.querySelectorAll<HTMLLIElement>("#etapes-commande li"))) {
      const j = ordre.indexOf(li.dataset.etape!);
      li.dataset.etat = j < i ? "fait" : j === i ? "actuel" : "a-venir";
      if (j === i) li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
    }
  }

  async function demarrer() {
    const [etat, moi] = await Promise.all([api("/api/paiement/etat", undefined, 8_000), api("/api/compte/moi", undefined, 8_000)]);
    const mode = etat.data?.mode;
    const ventes = etat.data?.ventes ?? {};
    if (!mode || !Object.values(ventes).some((v: any) => v.ouverte)) return;   // reste fermé : rien n'est simulé
    $("commandes-fermees").hidden = true;
    $("zone-commande").hidden = false;
    $("bandeau-test").hidden = mode !== "test";
    for (const [id, v] of Object.entries<any>(ventes)) {
      const input = form.querySelector(`input[name=formule][value="${id}"]`) as HTMLInputElement;
      input.disabled = !v.ouverte;
      const r = form.querySelector(`[data-raison="${id}"]`) as HTMLElement;
      r.hidden = v.ouverte;
      r.textContent = v.ouverte ? "" : `Indisponible : ${v.raisons.map((x: string) => RAISONS[x] ?? x).join(" ")}`;
    }
    if (params.get("annulee")) {
      message(zoneMsg, "info", "Paiement annulé", ["Vous avez quitté la page de paiement : aucun accès n’a été ouvert. Vous pouvez recommencer quand vous voulez."]);
    }
    if (!moi.data?.connecte) {
      etape("compte");
      ($("lien-compte") as HTMLAnchorElement).href = `/compte/?suite=${encodeURIComponent(location.pathname + location.search)}`;
      $("bloc-connexion").hidden = false;
      return;
    }
    etape("conditions");
    form.hidden = false;
  }

  form.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const donnees = {
      formule: formuleChoisie(),
      cgv: (form.elements.namedItem("cgv") as HTMLInputElement).checked,
      accesImmediat: (form.elements.namedItem("accesImmediat") as HTMLInputElement).checked,
      executionService: (form.elements.namedItem("executionService") as HTMLInputElement).checked,
    };
    const v = validerAchat(donnees);
    afficherErreurs(form, v.erreurs);
    if (!v.ok) return;
    const bouton = $("bouton-payer") as HTMLButtonElement;
    bouton.disabled = true;
    bouton.textContent = "Préparation du paiement…";
    etape("paiement");
    const r = await api("/api/paiement/session", donnees);
    if (r.statut === 201 && typeof r.data?.url === "string") { location.assign(r.data.url); return; }
    bouton.disabled = false;
    majFormule();
    if (r.data?.code === "deja_acquise") {
      message(zoneMsg, "info", "Vous avez déjà cette formule", [el("a", { class: "btn", href: "/formation/" }, "Aller à ma formation")]);
    } else if (r.statut === 401) {
      message(zoneMsg, "ko", "Session expirée", ["Reconnectez-vous puis recommencez.", el("a", { class: "btn", href: `/compte/?suite=${encodeURIComponent(location.pathname + location.search)}` }, "Me connecter")]);
    } else {
      message(zoneMsg, "ko", "Le paiement n’a pas pu être préparé", ["Aucun paiement n’a été demandé et aucun montant n’a été débité. Réessayez dans quelques minutes ou écrivez à " + site.contactEmail + "."]);
    }
  });

  demarrer();
</script>
