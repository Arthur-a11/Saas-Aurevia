---
import Base from "../layouts/Base.astro";
import programme from "../data/programme.json";
import { site } from "../lib/site.js";
---
<Base titre="Le programme" courant="/programme/"
  description="Le programme AUREVIA SAAS en six modules : trouver une idée, définir le produit minimum, construire, fixer le prix, trouver ses premiers clients, mesurer et grandir.">
  <section class="entete-page">
    <div class="wrap">
      <p class="retour"><a href="/">← Retour à l’accueil</a></p>
      <p class="surtitre">Le programme</p>
      <h1 class="titre-degrade">La formation : tout pour créer un bon SaaS</h1>
      <p class="chapeau">{programme.intro}</p>
    </div>
  </section>

  <section class="bande" aria-labelledby="modules">
    <div class="wrap">
      <h2 id="modules">Le programme, module par module</h2>
      <nav aria-label="Sommaire du programme" class="sommaire-programme">
        <ol>
          {programme.modules.map((m, i) => <li><a href={`#module-${i + 1}`}><span class="mono">{String(i + 1).padStart(2, "0")}</span> {m.titre}</a></li>)}
        </ol>
        <button type="button" class="btn alt petit sans-js-masque" id="tout-ouvrir" aria-controls="liste-modules">Tout ouvrir</button>
      </nav>
      <div id="liste-modules">
      {programme.modules.map((m, i) => (
        <details class="module" id={`module-${i + 1}`} open={i === 0}>
          <summary><span class="num-module" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>Module {i + 1} : {m.titre.charAt(0).toLowerCase() + m.titre.slice(1)}</summary>
          <p>{m.resume}</p>
          <ul>{m.points.map((pt) => <li>{pt}</li>)}</ul>
          <p class="resultat"><span class="pastille-livrable">Livrable</span> {m.resultat.replace(/^À la fin : /, "")}</p>
        </details>
      ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="checklist">
    <div class="wrap">
      <h2 id="checklist">La checklist d’un bon SaaS</h2>
      <p class="sous-titre">Vérifiez ces huit points avant de lancer.</p>
      <ul class="checklist">{programme.checklist.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="finale" aria-labelledby="pret">
    <div class="wrap">
      <h2 id="pret">Prêt à suivre la formation ?</h2>
      <p class="sous-titre">À partir de {site.formules[0].prixAffiche}, en un seul paiement.</p>
      <div class="cta"><a class="btn" href="/inscription/">Je m’inscris</a></div>
    </div>
  </section>
</Base>

<script>
  // Ouvre le module visé par un lien (#module-3) ; bouton « Tout ouvrir / Tout fermer ».
  const modules = Array.from(document.querySelectorAll<HTMLDetailsElement>("details.module"));
  const bouton = document.getElementById("tout-ouvrir") as HTMLButtonElement;
  const ouvrirCible = () => {
    const cible = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (cible instanceof HTMLDetailsElement && cible.classList.contains("module")) { cible.open = true; cible.querySelector("summary")?.focus(); }
  };
  window.addEventListener("hashchange", ouvrirCible);
  ouvrirCible();
  const maj = () => { bouton.textContent = modules.every((d) => d.open) ? "Tout fermer" : "Tout ouvrir"; };
  modules.forEach((d) => d.addEventListener("toggle", maj));
  bouton.addEventListener("click", () => { const ouvrir = !modules.every((d) => d.open); modules.forEach((d) => (d.open = ouvrir)); maj(); });
  maj();
</script>
