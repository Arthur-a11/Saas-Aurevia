---
import Base from "../layouts/Base.astro";
import programme from "../data/programme.json";
import { site } from "../lib/site.js";
---
<Base titre="Le programme" courant="/programme/"
  description="Le programme AUREVIA SAAS en six modules : trouver une idée, définir le produit minimum, construire, fixer le prix, trouver ses premiers clients, mesurer et grandir.">
  <section class="entete-page">
    <div class="wrap">
      <p class="retour"><a href="/">← Retour à l’accueil</a></p>
      <p class="surtitre">Le programme</p>
      <h1 class="titre-degrade">La formation : tout pour créer un bon SaaS</h1>
      <p class="chapeau">{programme.intro}</p>
    </div>
  </section>

  <section class="bande" aria-labelledby="modules">
    <div class="wrap">
      <h2 id="modules">Le programme, module par module</h2>
      <nav aria-label="Sommaire du programme" class="sommaire-programme">
        <ol>
          {programme.modules.map((m, i) => <li><a href={`#module-${i + 1}`}><span class="mono">{String(i + 1).padStart(2, "0")}</span> {m.titre}</a></li>)}
        </ol>
      </nav>
      <ol class="liste-modules" id="liste-modules">
      {programme.modules.map((m, i) => (
        <li class="carte module-bloc" id={`module-${i + 1}`}>
          <div class="module-tete">
            <span class="num-module" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 id={`titre-module-${i + 1}`}><span class="sr-only">Module {i + 1} : </span>{m.titre}</h3>
          </div>
          <p class="module-resume">{m.resume}</p>
          <p class="module-sous-titre">Au programme</p>
          <ul class="module-points">{m.points.map((pt) => <li>{pt}</li>)}</ul>
          <p class="resultat"><span class="pastille-livrable">Livrable</span> {m.resultat.replace(/^À la fin : /, "")}</p>
        </li>
      ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="checklist">
    <div class="wrap">
      <h2 id="checklist">La checklist d’un bon SaaS</h2>
      <p class="sous-titre">Vérifiez ces huit points avant de lancer.</p>
      <ul class="checklist">{programme.checklist.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="finale" aria-labelledby="pret">
    <div class="wrap">
      <h2 id="pret">Prêt à suivre la formation ?</h2>
      <p class="sous-titre">À partir de {site.formules[0].prixAffiche}, en un seul paiement.</p>
      <div class="cta"><a class="btn" href="/inscription/">Je m’inscris</a></div>
    </div>
  </section>
</Base>

