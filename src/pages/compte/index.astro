---
// Connexion et création de compte. Les comptes servent à retrouver ses achats et sa progression.
import Base from "../../layouts/Base.astro";
import Champ from "../../components/Champ.astro";
import Case from "../../components/Case.astro";
import PiegeRobots from "../../components/PiegeRobots.astro";
import { MDP_MIN } from "../../../serveur/validation.js";
---
<Base titre="Mon compte" noindex description="Connectez-vous ou créez votre compte AUREVIA SAAS pour accéder à votre formation.">
  <section class="entete-page">
    <div class="wrap">
      <p class="surtitre">Mon compte</p>
      <h1 class="titre-degrade">Accéder à ma formation</h1>
      <p class="chapeau">Votre compte vous permet de retrouver vos achats et votre progression à chaque connexion.</p>
    </div>
  </section>

  <section class="section-serree">
    <div class="wrap">
      <div id="zone-compte" class="message-formulaire info" role="status" hidden></div>
      <noscript><p class="encadre attention">Le compte nécessite JavaScript, désactivé dans votre navigateur.</p></noscript>
      <div class="grille-compte" id="formulaires-compte">
        <form class="carte formulaire formulaire-simple" id="form-connexion" novalidate aria-labelledby="titre-connexion">
          <h2 id="titre-connexion" class="titre-carte">J’ai déjà un compte</h2>
          <Champ nom="cx-email" label="E-mail" type="email" requis pleine autocomplete="email" max={254} />
          <Champ nom="cx-motDePasse" label="Mot de passe" type="password" requis pleine autocomplete="current-password" max={200} />
          <div class="pleine"><button class="btn" type="submit">Me connecter</button></div>
          <p class="note pleine"><a href="/compte/mot-de-passe-oublie/">Mot de passe oublié ?</a></p>
          <div class="pleine message-formulaire" id="msg-connexion" role="status" hidden></div>
        </form>

        <form class="carte formulaire formulaire-simple" id="form-creation" novalidate aria-labelledby="titre-creation">
          <h2 id="titre-creation" class="titre-carte">Créer mon compte</h2>
          <Champ nom="cr-prenom" label="Prénom" requis pleine autocomplete="given-name" max={80} />
          <Champ nom="cr-email" label="E-mail" type="email" requis pleine autocomplete="email" max={254} />
          <Champ nom="cr-motDePasse" label="Mot de passe" type="password" requis pleine autocomplete="new-password" max={200} aide={`${MDP_MIN} caractères au minimum. Une phrase facile à retenir fonctionne très bien.`} />
          <Case nom="cr-confidentialite" requis>J’ai pris connaissance de la <a href="/confidentialite/">politique de confidentialité</a> : mes informations servent à gérer mon compte et mes achats.</Case>
          <PiegeRobots />
          <div class="pleine"><button class="btn" type="submit">Créer mon compte</button></div>
          <div class="pleine message-formulaire" id="msg-creation" role="status" hidden></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { afficherErreurs, message } from "../../lib/formulaire";
  import { api, el, suiteSure } from "../../lib/espace-client";
  import { validerConnexion, validerCreationCompte } from "../../../serveur/validation.js";

  const suite = suiteSure(new URLSearchParams(location.search).get("suite"));
  const zone = document.getElementById("zone-compte") as HTMLElement;
  const blocs = document.getElementById("formulaires-compte") as HTMLElement;

  /** Les champs portent un préfixe (deux formulaires sur la page) ; le serveur attend les noms simples. */
  function lire(form: HTMLFormElement, prefixe: string) {
    const d: Record<string, unknown> = {};
    for (const e of Array.from(form.elements) as HTMLInputElement[]) {
      if (!e.name) continue;
      d[e.name.startsWith(prefixe) ? e.name.slice(prefixe.length) : e.name] = e.type === "checkbox" ? e.checked : e.value;
    }
    return d;
  }
  const prefixer = (erreurs: Record<string, string>, p: string) => Object.fromEntries(Object.entries(erreurs).map(([k, v]) => [p + k, v]));

  function brancherCompte(form: HTMLFormElement, prefixe: string, url: string, valider: (d: any) => any, msg: HTMLElement) {
    const bouton = form.querySelector("button[type=submit]") as HTMLButtonElement;
    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const d = lire(form, prefixe);
      const v = valider(d);
      afficherErreurs(form, prefixer(v.erreurs, prefixe));
      if (!v.ok) return;
      bouton.disabled = true;
      const r = await api(url, d);
      bouton.disabled = false;
      if (r.data?.ok) { location.assign(suite); return; }
      if (r.data?.erreurs) { afficherErreurs(form, prefixer(r.data.erreurs, prefixe)); return; }
      const textes: Record<string, string> = {
        identifiants_invalides: "E-mail ou mot de passe incorrect.",
        trop_de_demandes: "Trop d’essais. Patientez quelques minutes avant de réessayer.",
        stockage_non_configure: "Les comptes ne sont pas encore en service sur ce site.",
      };
      message(msg, "ko", "Action impossible", [textes[r.data?.code] ?? "Le serveur ne répond pas. Rien n’a été enregistré : réessayez dans quelques minutes."]);
    });
  }

  brancherCompte(document.getElementById("form-connexion") as HTMLFormElement, "cx-", "/api/compte/connexion", validerConnexion, document.getElementById("msg-connexion") as HTMLElement);
  brancherCompte(document.getElementById("form-creation") as HTMLFormElement, "cr-", "/api/compte/creation", validerCreationCompte, document.getElementById("msg-creation") as HTMLElement);

  // Déjà connecté : on le dit, avec l'accès direct et la déconnexion.
  api("/api/compte/moi", undefined, 8_000).then((moi) => {
    if (!moi.data?.connecte) return;
    blocs.hidden = true;
    const sortir = el("button", { type: "button", class: "btn alt" }, "Me déconnecter");
    sortir.addEventListener("click", async () => { await api("/api/compte/deconnexion", {}); location.reload(); });
    message(zone, "ok", `Vous êtes connecté(e) : ${moi.data.prenom}`, [`Adresse : ${moi.data.email}`, el("p", { class: "cta" }, el("a", { class: "btn", href: suite }, "Continuer"), sortir)]);
  });
</script>
