---
import Base from "../layouts/Base.astro";
import faq from "../data/faq.json";
---
<Base titre="Questions fréquentes" courant="/questions/"
  description="Les réponses aux questions fréquentes sur la formation AUREVIA SAAS : niveau requis, temps nécessaire, ressources, idées de SaaS.">
  <section class="entete-page">
    <div class="wrap">
      <h1 class="titre-degrade">Vos questions</h1>
      <p class="chapeau">Les réponses aux questions les plus fréquentes. Une autre question ? <a href="/contact/">Écrivez-moi</a>.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      {faq.map((q) => (
        <details>
          <summary><h2>{q.question}</h2></summary>
          <p>{q.reponse}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
