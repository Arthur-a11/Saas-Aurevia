---
// Carte d'une formule (accueil et page Tarifs). Source unique : src/data/formation.json (via offres.js).
// On affiche le socle commun, puis UNIQUEMENT ce que la formule ajoute à la précédente, avec l'état réel.
// Le bouton mène à l'inscription sans paiement ; il ne mène à la commande que si le SERVEUR indique
// que la vente de cette formule est ouverte (paiement configuré).
import { site, mentionTaxes, LIBELLE_STATUT } from "../lib/site.js";
import { contenuOffre } from "../lib/offres.js";
import conditions from "../data/conditions.json";
interface Props { f: (typeof site.formules)[number] }
const { f } = Astro.props;
const i = site.formules.findIndex((x) => x.id === f.id);
const precedente = i > 0 ? site.formules[i - 1] : null;
const droitsPrecedents = new Set(precedente ? contenuOffre(precedente.id).map((x) => x.droit) : []);
const contenu = contenuOffre(f.id);
const socle = precedente ? [] : contenu;
const ajouts = precedente ? contenu.filter((x) => !droitsPrecedents.has(x.droit)) : [];
const duree = conditions.dureeAcces.valeur ? conditions.dureeAcces.options[conditions.dureeAcces.valeur] : null;
---
<li class={`carte tarif${f.recommandee ? " recommandee" : ""}`}>
  <div class="haut">{f.recommandee && <span class="badge">Notre recommandation</span>}</div>
  <h3>{f.nom}</h3>
  <p class="montant">{f.prixAffiche}<span class="taxes">{mentionTaxes()}</span></p>
  <p class="frequence">Paiement unique · sans abonnement</p>
  <p class="obtenez">{precedente ? `Tout ${precedente.nom === "Essentiel" ? "l’Essentiel" : `le ${precedente.nom}`}, plus` : "Ce que vous obtenez"}</p>
  <ul>
    {(precedente ? ajouts : socle).map((x) => (
      <li>{x.texte}{LIBELLE_STATUT[x.statut] && <span class="statut">{LIBELLE_STATUT[x.statut]}</span>}</li>
    ))}
  </ul>
  <p class="acces-tarif">Accès : {duree ?? "durée à définir"}</p>
  <a class={`btn${f.recommandee ? "" : " alt"}`} data-formule={f.id}
     href={`/inscription/?formule=${f.id}`}
     aria-label={`Choisir la formule ${f.nom} (${f.prixAffiche})`}>
    Choisir
  </a>
</li>

<script>
  import { api } from "../lib/espace-client";
  // Vente ouverte côté serveur → le bouton mène à la commande. Sinon : inscription sans paiement.
  api("/api/paiement/etat", undefined, 8_000).then((r) => {
    if (!r.data?.mode) return;
    if (Object.values<any>(r.data.ventes ?? {}).some((v) => v.ouverte)) document.getElementById("avis-commandes")?.setAttribute("hidden", "");
    for (const a of Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-formule]"))) {
      if (r.data.ventes?.[a.dataset.formule!]?.ouverte) a.href = `/commande/?formule=${a.dataset.formule}`;
    }
  });
</script>
