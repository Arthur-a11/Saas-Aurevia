---
// Assistant du site : bouton flottant + panneau de discussion.
// 1. Essaie l'assistant IA côté serveur (/api/assistant) : la clé API n'est jamais dans le navigateur.
// 2. Si l'IA n'est pas connectée, saturée ou limitée : réponses de secours tirées des données du site.
---
<div id="assistant" class="assistant">
  <button class="chat-ouvrir" id="chat-ouvrir" type="button" aria-expanded="false" aria-controls="chat-panneau">
    <span class="orb" aria-hidden="true"></span><span class="chat-libelle">Posez votre question</span>
  </button>
  <section class="chat-panneau" id="chat-panneau" role="dialog" aria-modal="false" aria-labelledby="chat-titre" hidden>
    <div class="chat-tete">
      <span class="orb" aria-hidden="true"></span>
      <div>
        <h2 id="chat-titre">Assistant</h2>
        <p class="chat-etat" id="chat-etat">Réponses automatiques, qui peuvent contenir des erreurs.</p>
      </div>
      <button type="button" class="chat-fermer" id="chat-fermer" aria-label="Fermer l’assistant">×</button>
    </div>
    <div class="chat-journal" id="chat-journal" aria-live="polite" aria-relevant="additions">
      <p class="bot">Bonjour ! Posez-moi vos questions sur la formation AUREVIA SAAS. N’indiquez pas de données personnelles sensibles ni bancaires.</p>
    </div>
    <div class="chat-suggestions" id="chat-suggestions">
      <button type="button" data-q="Que contient le programme ?">Que contient le programme ?</button>
      <button type="button" data-q="Quels sont les prix ?">Quels sont les prix ?</button>
      <button type="button" data-q="Faut-il savoir coder ?">Faut-il savoir coder ?</button>
      <button type="button" data-q="Comment m’inscrire ?">Comment m’inscrire ?</button>
    </div>
    <form class="chat-form" id="chat-form">
      <label for="chat-question" class="sr-only">Votre question</label>
      <input id="chat-question" name="question" maxlength="600" autocomplete="off" placeholder="Écrivez votre question…" required />
      <button type="submit" aria-label="Envoyer la question">➤</button>
    </form>
  </section>
</div>

<style is:global>
  /* Placé au-dessus de la zone du badge « Powered by Netlify » (cadre fixe de 64 px de haut en bas à droite,
     ajouté par Netlify sur le site en ligne) : sinon le badge recouvre le bouton et l'assistant est inutilisable. */
  .assistant { position: fixed; right: 1rem; bottom: calc(var(--zone-badge) + 1rem + env(safe-area-inset-bottom, 0px)); z-index: 20; }
  .orb { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; flex: none;
    background: radial-gradient(circle at 35% 35%, #c9ffe0, var(--chat-vert) 60%, #12915a);
    box-shadow: 0 0 12px var(--chat-vert); }
  .chat-ouvrir { display: flex; align-items: center; gap: 0.6rem; font: 600 1rem var(--police-texte); color: #fff;
    background: var(--chat-bg); border: 1px solid rgba(61, 220, 132, 0.6); border-radius: 999px;
    padding: 0.8rem 1.2rem; min-height: 48px; cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
  .chat-ouvrir[hidden] { display: none; }
  .chat-ouvrir:hover { border-color: var(--chat-vert); }
  /* Sur mobile : bouton rond et compact, pour ne pas cacher le contenu. */
  @media (max-width: 820px) {
    .chat-ouvrir { width: 3.25rem; height: 3.25rem; padding: 0; justify-content: center; }
    .chat-ouvrir .orb { width: 1.1rem; height: 1.1rem; }
    .chat-libelle { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  .chat-panneau { width: min(390px, calc(100vw - 2rem)); max-height: min(78vh, 640px); display: flex; flex-direction: column; gap: 0.75rem;
    padding: 1rem; color: #eaf2ff; background: var(--chat-bg); border: 1px solid rgba(61, 220, 132, 0.4); border-radius: 22px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45); }
  .chat-panneau[hidden] { display: none; }
  .chat-tete { display: flex; align-items: center; gap: 0.7rem; }
  .chat-tete > div { flex: 1; }
  .chat-tete h2 { font-size: 1.05rem; margin: 0; }
  .chat-tete h2::after { display: none; }
  .chat-etat { color: var(--chat-muted); font-size: 0.8rem; margin: 0; }
  .chat-fermer { border: 0; background: none; color: #c8d3ea; font-size: 1.8rem; line-height: 1; cursor: pointer; min-width: 44px; min-height: 44px; }
  .chat-journal { overflow-y: auto; display: grid; gap: 0.55rem; align-content: start; min-height: 130px; max-height: 42vh; padding-right: 0.2rem; }
  .chat-journal p { margin: 0; padding: 0.65rem 0.9rem; border-radius: 16px; font-size: 0.95rem; line-height: 1.5; max-width: 92%; white-space: pre-line; }
  .chat-journal .bot { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); border-top-left-radius: 4px; justify-self: start; }
  .chat-journal .moi { background: linear-gradient(135deg, var(--chat-vert), #22d3ee); color: #06121b; font-weight: 500; border-top-right-radius: 4px; justify-self: end; }
  .chat-journal .bot a { color: var(--lien); display: inline-block; margin-top: 0.35rem; }
  .chat-journal .source { display: block; color: var(--chat-muted); font-size: 0.78rem; margin-top: 0.35rem; }
  .chat-suggestions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chat-suggestions button { font: 500 0.82rem var(--police-texte); color: #cff8e1; background: rgba(61, 220, 132, 0.1);
    border: 1px solid rgba(61, 220, 132, 0.45); border-radius: 999px; padding: 0.35rem 0.75rem; cursor: pointer; min-height: 36px; }
  .chat-suggestions button:hover { background: rgba(61, 220, 132, 0.25); }
  .chat-form { display: flex; gap: 0.5rem; align-items: center; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px; padding: 0.3rem 0.3rem 0.3rem 1rem; }
  .chat-form:focus-within { border-color: var(--chat-vert); box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.25); }
  .chat-form input { flex: 1; min-width: 0; font: inherit; color: #fff; background: transparent; border: 0; outline: 0; padding: 0.5rem 0; }
  .chat-form input::placeholder { color: var(--chat-muted); }
  .chat-form button { flex: none; width: 2.6rem; height: 2.6rem; border: 0; border-radius: 50%; background: var(--chat-vert); color: #06121b; font-size: 1rem; cursor: pointer; }
</style>

<script>
  // Les réponses de secours (avec la liste des marchés et niches) ne sont chargées qu'en cas de besoin.
  const repondreLocalement = async (q: string) => (await import("../lib/assistant-local.js")).repondreLocalement(q);

  const ouvrirBtn = document.getElementById("chat-ouvrir") as HTMLButtonElement;
  const panneau = document.getElementById("chat-panneau") as HTMLElement;
  const journal = document.getElementById("chat-journal") as HTMLElement;
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const champ = document.getElementById("chat-question") as HTMLInputElement;
  const historique: { role: "user" | "assistant"; texte: string }[] = [];
  let occupe = false;

  function ouvrir(o: boolean) {
    panneau.hidden = !o;
    ouvrirBtn.hidden = o;
    ouvrirBtn.setAttribute("aria-expanded", String(o));
    if (o) champ.focus();
    else ouvrirBtn.focus();
  }
  ouvrirBtn.addEventListener("click", () => ouvrir(true));
  document.getElementById("chat-fermer")!.addEventListener("click", () => ouvrir(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !panneau.hidden) { e.preventDefault(); ouvrir(false); }
  });

  function ajouter(classe: string, texte: string, liens: { href: string; label: string }[] = [], source = "") {
    const p = document.createElement("p");
    p.className = classe;
    p.textContent = texte;
    for (const l of liens) {
      p.append(document.createElement("br"));
      const a = document.createElement("a");
      a.href = l.href;
      a.textContent = l.label + " →";
      p.append(a);
    }
    if (source) {
      const s = document.createElement("span");
      s.className = "source";
      s.textContent = source;
      p.append(s);
    }
    journal.append(p);
    journal.scrollTop = journal.scrollHeight;
    return p;
  }

  async function demander(question: string) {
    const attente = ajouter("bot", "…");
    attente.setAttribute("aria-hidden", "true");
    let reponse: { texte: string; liens: { href: string; label: string }[]; source: string } | null = null;
    try {
      const r = await fetch("/api/assistant", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question, historique: historique.slice(-6) }),
        signal: AbortSignal.timeout(12_000),   // au-delà : réponse de secours
      });
      const data = await r.json().catch(() => null);
      if (r.ok && data?.ok && typeof data.reponse === "string") {
        reponse = { texte: data.reponse, liens: [], source: "Réponse générée par l’IA, à vérifier." };
      } else if (r.status === 429) {
        const local = await repondreLocalement(question);
        reponse = { ...local, source: "Limite d’utilisation de l’assistant IA atteinte : réponse tirée du site." };
      }
    } catch {
      /* réseau indisponible : réponse de secours */
    }
    if (!reponse) reponse = { ...(await repondreLocalement(question)), source: "Réponse tirée des informations du site." };
    attente.remove();
    ajouter("bot", reponse.texte, reponse.liens, reponse.source);
    historique.push({ role: "assistant", texte: reponse.texte });
  }

  async function poser(question: string) {
    const q = question.trim().slice(0, 600);
    if (!q || occupe) return;
    occupe = true;
    ajouter("moi", q);
    historique.push({ role: "user", texte: q });
    try { await demander(q); } finally { occupe = false; }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = champ.value;
    champ.value = "";
    poser(q);
  });
  document.getElementById("chat-suggestions")!.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-q]");
    if (b) poser(b.dataset.q || "");
  });
</script>
